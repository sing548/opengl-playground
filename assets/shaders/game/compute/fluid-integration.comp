#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions    { vec4 positions[]; };
layout(std430, binding = 1) buffer Velocities   { vec4 velocities[]; };
layout(std430, binding = 4) buffer Forces       { vec4 forces[]; };

uniform uint count;
uniform float dT;
uniform float restitution;
uniform vec3 boundingBox;

void CheckCollision(inout vec4 position, inout vec4 velocity);

void main()
{
    uint i = gl_GlobalInvocationID.x;
    
    if (i >= count) return;

    velocities[i] += forces[i] * dT;
    positions[i] = vec4((positions[i] + velocities[i] * dT).xyz, length(velocities[i].xyz));
    CheckCollision(positions[i], velocities[i]);
}

void CheckCollision(inout vec4 position, inout vec4 velocity)
{
    if (abs(position.x) > boundingBox.x)
    {
        velocity.x *= -restitution;
        position.x = clamp(position.x, -boundingBox.x, boundingBox.x);
    }

    if (abs(position.y) > boundingBox.y)
    {
        velocity.y *= -restitution;
        position.y = clamp(position.y, -boundingBox.y, boundingBox.y);
    }

    if (abs(position.z) > boundingBox.z)
    {
        velocity.z *= -restitution;
        position.z = clamp(position.z, -boundingBox.z, boundingBox.z);
    }
}
