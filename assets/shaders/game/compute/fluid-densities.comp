#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 2)          buffer Predictions { vec4 predictions[]; };
// x: Density, y: NearDensity, z: PressureTerms, w: empty
layout(std430, binding = 3)          buffer Densities   { vec4 densities[]; };
layout(std430, binding = 5) readonly buffer Hashes      { uint hashes[]; };
layout(std430, binding = 7) readonly buffer Starts      { uint starts[]; };

uniform uint count;
uniform uint tableSize;
uniform float mass;
uniform float nearScale;
uniform float spikyScale;
uniform float targetDensity;
uniform float inversCellSize;
uniform float smoothingRadius;
uniform float pressureMultiplier;

uint HashCell(ivec3 c);
float SmoothingFunction(float distance);
float SmoothingFunctionNear(float distance);
float DensityToPressure(float density);

void main()
{
    uint i = gl_GlobalInvocationID.x;
    
    if (i >= count) return;

    vec3 position = predictions[i].xyz;
    ivec3 cell = ivec3(floor(position * inversCellSize));

    float density = 0.0;
    float nearDensity = 0.0;

    for (int dx = -1; dx <= 1; ++dx)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dz = -1; dz <= 1; ++dz)
    {
        uint cellHash = HashCell(cell + ivec3(dx, dy, dz));
        uint key = cellHash % tableSize;

        uint end = starts[key + 1u];
        
        for (uint j = starts[key]; j < end; ++j) {
            if (hashes[j] != cellHash) continue;

            float distance = length(predictions[j].xyz - predictions[i].xyz);
            density += mass * SmoothingFunction(distance);
            nearDensity += mass * SmoothingFunctionNear(distance);
        }
    }

    densities[i] = vec4(density, nearDensity, DensityToPressure(density) / (density * density), 0.0);
}

float SmoothingFunction(float distance)
{
    if (distance >= smoothingRadius) return 0.0f;

    float val = max(0.0f, smoothingRadius - distance);
    return val * val * val * spikyScale;
}

float SmoothingFunctionNear(float distance)
{
    if (distance >= smoothingRadius) return 0.0f;

    float val = max(0.0f, smoothingRadius - distance);
    return val * val * val * val * nearScale;
}

float DensityToPressure(float density)
{
    float dE = density - targetDensity;
    float pressure = dE * pressureMultiplier;
    return pressure;
}

uint HashCell(ivec3 cell)
{
    return uint(cell.x) * 28579u + uint(cell.y) * 58229u + uint(cell.z) * 82759u;
}
