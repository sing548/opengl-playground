#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly    buffer Positions { vec4 positions[]; };
layout(std430, binding = 1)             buffer Velocities { vec4 velocities[]; };
layout(std430, binding = 2) writeonly   buffer Predictions { vec4 predictions[]; };

uniform uint count;
uniform float dT;
uniform float gravity;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    
    if (i >= count) return;

    velocities[i].z -= gravity * dT;

    predictions[i] = vec4((positions[i] + velocities[i] * dT).xyz, 0.0);
}
